%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d79969c9916491d86d88d769faa8f80, type: 3}
  m_Name: OrganInfoLibrary
  m_EditorClassIdentifier: 
  _entries:
  - _organName: "ascending_colon"
    _displayName: "Ascending colon"
    _function: "The first part of the large intestine; it absorbs water and salts from waste coming from the small intestine."
    _fact: "It rises along the right side of the abdomen from the pouch where the appendix is attached."
    _system: "Digestive system"
    _role: "Absorbs water"
  - _organName: "descending_colon"
    _displayName: "Descending colon"
    _function: "Carries waste down the left side of the abdomen and stores it until it moves on to the sigmoid colon."
    _fact: "It is fixed against the back wall of the abdomen, unlike the transverse colon, which hangs free."
    _system: "Digestive system"
    _role: "Stores waste"
  - _organName: "duodenum"
    _displayName: "Duodenum"
    _function: "The first part of the small intestine; it mixes food from the stomach with bile and pancreatic juice."
    _fact: "It is about 25 centimetres long and curves around the head of the pancreas."
    _system: "Digestive system"
    _role: "Mixes food with bile"
  - _organName: "gallbladder"
    _displayName: "Gallbladder"
    _function: "Stores and concentrates bile made by the liver and releases it to help digest fats."
    _fact: "It is a small pear-shaped sac that holds roughly 30 to 50 millilitres of bile."
    _system: "Digestive system"
    _role: "Stores bile"
  - _organName: "inferior_lobe_of_left_lung"
    _displayName: "Inferior lobe of left lung"
    _function: "The lower lobe of the left lung, where oxygen passes into the blood and carbon dioxide leaves it."
    _fact: "The left lung has two lobes, the superior and the inferior, while the right lung has three."
    _system: "Respiratory system"
    _role: "Exchanges gases"
  - _organName: "inferior_lobe_of_right_lung"
    _displayName: "Inferior lobe of right lung"
    _function: "The lower lobe of the right lung, where oxygen passes into the blood and carbon dioxide leaves it."
    _fact: "The right lung has three lobes: superior, middle and inferior."
    _system: "Respiratory system"
    _role: "Exchanges gases"
  - _organName: "kidney_l"
    _displayName: "Left kidney"
    _function: "Filters the blood to make urine, removing waste and helping to balance the body's water and salts."
    _fact: "The left kidney usually sits a little higher than the right one."
    _system: "Urinary system"
    _role: "Filters blood"
  - _organName: "kidney_r"
    _displayName: "Right kidney"
    _function: "Filters the blood to make urine, removing waste and helping to balance the body's water and salts."
    _fact: "The right kidney usually sits a little lower than the left because the liver lies above it."
    _system: "Urinary system"
    _role: "Filters blood"
  - _organName: "left_atrium"
    _displayName: "Left atrium"
    _function: "The upper left chamber of the heart; it receives oxygen-rich blood from the lungs and passes it to the left ventricle."
    _fact: "It forms most of the back surface of the heart."
    _system: "Circulatory system"
    _role: "Receives blood from lungs"
  - _organName: "left_ventricle"
    _displayName: "Left ventricle"
    _function: "The lower left chamber of the heart; it pumps oxygen-rich blood into the aorta and out to the whole body."
    _fact: "Its muscle wall is about three times thicker than the right ventricle's."
    _system: "Circulatory system"
    _role: "Pumps blood to the body"
  - _organName: "liver"
    _displayName: "Liver"
    _function: "Makes bile, processes nutrients from the gut, stores energy and clears many substances from the blood."
    _fact: "It is the largest internal organ, weighing about 1.5 kilograms in an adult."
    _system: "Digestive system"
    _role: "Produces bile"
  - _organName: "middle_lobe_of_right_lung"
    _displayName: "Middle lobe of right lung"
    _function: "The middle lobe of the right lung, where oxygen passes into the blood and carbon dioxide leaves it."
    _fact: "It is the smallest lobe of the right lung, and the left lung has no middle lobe."
    _system: "Respiratory system"
    _role: "Exchanges gases"
  - _organName: "mucosa_of_stomach"
    _displayName: "Mucosa of stomach"
    _function: "The inner lining of the stomach; it makes acid, enzymes and a layer of mucus that protects the wall."
    _fact: "Its folds, called rugae, flatten out as the stomach fills."
    _system: "Digestive system"
    _role: "Secretes gastric juice"
  - _organName: "pancreas"
    _displayName: "Pancreas"
    _function: "Makes digestive enzymes for the small intestine and hormones such as insulin that control blood sugar."
    _fact: "It lies behind the stomach, and its head sits in the curve of the duodenum."
    _system: "Digestive system"
    _role: "Makes enzymes and insulin"
  - _organName: "right_atrium"
    _displayName: "Right atrium"
    _function: "The upper right chamber of the heart; it receives oxygen-poor blood from the body and passes it to the right ventricle."
    _fact: "The heart's natural pacemaker, the sinoatrial node, is in the wall of this chamber."
    _system: "Circulatory system"
    _role: "Receives blood from the body"
  - _organName: "right_ventricle"
    _displayName: "Right ventricle"
    _function: "The lower right chamber of the heart; it pumps oxygen-poor blood through the pulmonary artery to the lungs."
    _fact: "It forms most of the front surface of the heart, just behind the breastbone."
    _system: "Circulatory system"
    _role: "Pumps blood to the lungs"
  - _organName: "sigmoid_colon"
    _displayName: "Sigmoid colon"
    _function: "The S-shaped last bend of the colon; it holds waste until it passes into the rectum."
    _fact: "Its name comes from the Greek letter sigma, because of its S shape."
    _system: "Digestive system"
    _role: "Leads waste to the rectum"
  - _organName: "spleen"
    _displayName: "Spleen"
    _function: "Filters the blood, removes old red blood cells and helps the immune system fight infection."
    _fact: "It lies in the upper left of the abdomen, under the ribs, and is about the size of a fist."
    _system: "Lymphatic system"
    _role: "Filters blood"
  - _organName: "stomach"
    _displayName: "Stomach"
    _function: "Stores swallowed food, churns it with acid and enzymes and releases it slowly into the duodenum."
    _fact: "It can stretch to hold about a litre or more of food and drink."
    _system: "Digestive system"
    _role: "Breaks down food"
  - _organName: "superior_lobe_of_left_lung"
    _displayName: "Superior lobe of left lung"
    _function: "The upper lobe of the left lung, where oxygen passes into the blood and carbon dioxide leaves it."
    _fact: "Its inner edge has a notch, the cardiac notch, that makes room for the heart."
    _system: "Respiratory system"
    _role: "Exchanges gases"
  - _organName: "superior_lobe_of_right_lung"
    _displayName: "Superior lobe of right lung"
    _function: "The upper lobe of the right lung, where oxygen passes into the blood and carbon dioxide leaves it."
    _fact: "The right lung is a little larger than the left because the heart takes up room on the left."
    _system: "Respiratory system"
    _role: "Exchanges gases"
  - _organName: "transverse_colon"
    _displayName: "Transverse colon"
    _function: "Carries waste across the abdomen from the right side to the left while more water is absorbed."
    _fact: "It is the longest and most mobile part of the large intestine."
    _system: "Digestive system"
    _role: "Absorbs water"
